{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "JWT": {
        "Secret": "MyVeryLongAndSecureJwtSecretKey12345!",
        "Issuer": "EventTicketBookingService",
        "Audience": "EventTicketBookingService.Users",
        "LifeTimeMinutes": 60
    },
    "Kafka": {
        "BootstrapServers": "localhost:9092",
        "Acks": "All",
        "ConsumerGroup": "event-service",
        "AutoOffsetReset": "Earliest",
        "EnableAutoCommit": false,
        "EnableAutoOffsetStore": false
    }
}
